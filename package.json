{
  "name": "tpp-bgremover",
  "productName": "Background Remover",
  "version": "0.1.0",
  "description": "Background-removal desktop app powered by RMBG-1.4",
  "main": "out/main/index.js",
  "author": "TPP",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "npm run build:worker && electron-vite dev",
    "build": "electron-vite build && npm run build:worker",
    "build:worker": "vite build --config vite.worker.config.ts",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "fetch-node": "node scripts/download-node-binaries.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "prepare:cross-deps": "node scripts/install-cross-deps.mjs",
    "prepare:pack": "npm run prepare:cross-deps && npm run fetch-node",
    "pack:mac": "npm run prepare:pack && npm run build && electron-builder --mac --arm64",
    "pack:win": "npm run prepare:pack && npm run build && electron-builder --win --x64",
    "pack:all": "npm run prepare:pack && npm run build && electron-builder --mac --win"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@huggingface/transformers": "^4.0.1",
    "exceljs": "^4.4.0",
    "papaparse": "^5.5.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
